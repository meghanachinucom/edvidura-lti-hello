# Anthropic (recommended for better topic → interaction plans)
# Prefer ANTHROPIC_API_KEY (kept on the Vite proxy — not shipped to the browser).
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: put the key in VITE_ only for local experiments (exposed to the browser).
# VITE_ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible chapter planner instead of Anthropic.
# VITE_OPENAI_API_KEY=
# VITE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# VITE_LLM_MODEL=gpt-4o-mini

# Optional: Meshy text→3D (otherwise local placeholder / procedural model).
# VITE_MESHY_API_KEY=
