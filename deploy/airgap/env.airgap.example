# Copy to env.airgap (do not commit secrets) for deploy/airgap/docker-compose.yml

AIRGAP=1
ENVIRONMENT=production
APP_BASE_URL=http://edvidura.internal:8000
SESSION_SECRET=replace-with-32-plus-char-random-string
ADMIN_API_KEY=replace-with-16-plus-char-ops-key

# App role preferred once ensure_app_role.sql is applied; owner works for first boot.
DATABASE_URL=postgresql://edvidura:edvidura@db:5432/edvidura
RUN_MIGRATIONS=1

# LTI key: mount PEM or set LTI_PRIVATE_KEY_PEM
# LTI_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Local AI only (or leave AI_ENABLED unset for heuristics)
AI_ENABLED=1
AI_PROVIDER=local_http
LOCAL_AI_BASE_URL=http://ollama:11434/v1
LOCAL_AI_MODEL=llama3.2

JEV_ENABLED=0
# leave OPENAI_*, ANTHROPIC_*, TYPESAFE_*, SENTRY_DSN unset
