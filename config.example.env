# Copy to .env and fill after Moodle registration

# Public URL of this tool as seen by the BROWSER (must resolve in Chrome/Edge).
# Moodle-in-Docker still fetches JWKS via host.docker.internal (set in tool config).
APP_BASE_URL=http://localhost:8000

# Session signing key (change me)
SESSION_SECRET=change-me-to-a-long-random-string

# Ops secret for /admin/* tenant onboarding (header X-Admin-Key or onboard form)
ADMIN_API_KEY=dev-admin-change-me

# Path to RSA private key (PEM) used for tool JWKS
LTI_PRIVATE_KEY_PATH=keys/private.key

# Shared EdVidura Postgres (docker compose in db/)
# Use edvidura_app (non-superuser) so RLS applies
DATABASE_URL=postgresql://edvidura_app:edvidura_app@127.0.0.1:5433/edvidura

# Moodle (Tenant A) — optional local seed only (scripts/seed_platforms.py).
# Runtime LTI config always comes from lti_platforms in Postgres.
MOODLE_ISSUER=http://localhost:8085
MOODLE_CLIENT_ID=48bFAclA7i5cKq2
MOODLE_DEPLOYMENT_IDS=1
MOODLE_AUTH_LOGIN_URL=http://localhost:8085/mod/lti/auth.php
MOODLE_AUTH_TOKEN_URL=http://localhost:8085/mod/lti/token.php
MOODLE_KEY_SET_URL=http://localhost:8085/mod/lti/certs.php
