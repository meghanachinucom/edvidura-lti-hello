# Copy to .env and fill after Moodle registration

# development | staging | production
# production/staging refuse weak secrets and require https APP_BASE_URL
ENVIRONMENT=development

# Public URL of this tool as seen by the BROWSER (must resolve in Chrome/Edge).
# Moodle-in-Docker still fetches JWKS via host.docker.internal (set in tool config).
APP_BASE_URL=http://localhost:8000

# Session signing key (change me — required ≥24 chars in staging/production)
SESSION_SECRET=change-me-to-a-long-random-string

# Ops secret for /admin/*, /api/v1/*, /dev/* (header X-Admin-Key or onboard form)
ADMIN_API_KEY=dev-admin-change-me

# Path to RSA private key (PEM) used for tool JWKS
LTI_PRIVATE_KEY_PATH=keys/private.key

# Shared EdVidura Postgres (docker compose in db/)
# Use edvidura_app (non-superuser) so RLS applies
DATABASE_URL=postgresql://edvidura_app:edvidura_app@127.0.0.1:5433/edvidura

# Railway: paste PEM as a single line with \n, or rely on entrypoint writing keys/private.key
# LTI_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# RUN_MIGRATIONS=1
# ENVIRONMENT=production

# Moodle (Tenant A) — optional local seed only (scripts/seed_platforms.py).
# Runtime LTI config always comes from lti_platforms in Postgres.
MOODLE_ISSUER=http://localhost:8085
MOODLE_CLIENT_ID=48bFAclA7i5cKq2
MOODLE_DEPLOYMENT_IDS=1
MOODLE_AUTH_LOGIN_URL=http://localhost:8085/mod/lti/auth.php
MOODLE_AUTH_TOKEN_URL=http://localhost:8085/mod/lti/token.php
MOODLE_KEY_SET_URL=http://localhost:8085/mod/lti/certs.php

# Optional xAPI LRS (leave empty = store statements in Postgres only)
# XAPI_LRS_ENDPOINT=https://your-lrs.example/xAPI
# XAPI_LRS_KEY=
# XAPI_LRS_SECRET=
# XAPI_ACTOR_HOMEPAGE=http://localhost:8085

# Optional AI quiz generation (local heuristic works without a key)
# AI_ENABLED=1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Keycloak ops identity (Moodle LTI stays the learner front door)
# KEYCLOAK_ENABLED=1
# KEYCLOAK_URL=http://localhost:8087
# KEYCLOAK_REALM=edvidura
# KEYCLOAK_CLIENT_ID=edvidura-api
# KEYCLOAK_CLIENT_SECRET=edvidura-api-dev-secret

# Metabase link shown on teacher Analytics (start with: cd db && docker compose --profile bi up -d)
# METABASE_URL=http://localhost:3001
